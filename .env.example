# Copy this file to .env (same folder as server.py) and fill ONE provider key. Restart the server after editing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Ollama / vLLM / LM Studio need no key. Optional:
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=

# Optional defaults (the UI can override per run)
# COPILOT_LLM_PROVIDER=anthropic
